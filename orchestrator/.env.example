# Environment variables of the MASTRO MCP Gateway (copy to .env and adapt).

# ── MOSAIC Orchestrator ───────────────────────────────────────────────────────
ORCHESTRATOR_URL=http://192.168.1.10:9000

# ── MASTRO backend (gateway-management tools: mastro_mcp_*) ──────────────────
MASTRO_URL=http://192.168.1.10:9100

# ── Runtime nodes — format: comma-separated node_id:host:port ─────────────────
# Add one entry for each testbed node
MOSAIC_RUNTIME_NODES=fog1:192.168.1.10:7000,fog2:192.168.1.11:7001,server:192.168.1.12:7002

# ── HTTP client ───────────────────────────────────────────────────────────────
MOSAIC_TIMEOUT=10
MOSAIC_RETRIES=2

# ── Offline development — set to true to use mock data ────────────────────────
MOCK_MODE=false

# ── Safety — set to true to log writes without executing them ─────────────────
DRY_RUN=false

# ── Write tool rate limiting — minimum seconds between consecutive writes ─────
MOSAIC_WRITE_INTERVAL=5
